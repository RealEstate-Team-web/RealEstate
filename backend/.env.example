# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate
DB_USER=root
DB_PASSWORD=your_password

# Client (frontend origin allowed by CORS)
CLIENT_URL=http://localhost:5173

# Authentication (used by the Authentication module)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (image uploads) - each developer uses their own account in local .env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=real-estate
