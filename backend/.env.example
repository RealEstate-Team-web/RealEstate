# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate
DB_USER=root
DB_PASSWORD=your_password

# Client (frontend origin allowed by CORS)
CLIENT_URL=http://localhost:5173

# Authentication (used by the Authentication module)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Rate limiting (optional; default: strict in production, DISABLED in development)
# LOGIN_RATE_LIMIT=5
# REGISTER_RATE_LIMIT=10
# FORGOT_RATE_LIMIT=5

# Mailer (optional; if unset, reset links are logged to the server console)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
# MAIL_FROM="Betenya <no-reply@betenya.com>"

# Cloudinary (image uploads) - each developer uses their own account in local .env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=real-estate

# Chapa payments (TEST MODE ONLY)
# Get test keys from the Chapa dashboard (https://dashboard.chapa.co). Never use live keys.
CHAPA_MODE=test
# Test secret key: prefix CHAPA_TEST_PRIV_ (current dashboard) or CHASECK_TEST- (legacy).
CHAPA_SECRET_KEY=
# Test public key: prefix CHAPA_TEST_PUB_.
CHAPA_PUBLIC_KEY=
# Set the same secret hash value that you enter under Profile > Webhooks in the Chapa dashboard.
CHAPA_WEBHOOK_SECRET=
# Optional override; the public Chapa API is used by default.
# CHAPA_API_URL=https://api.chapa.global/v2
# Where the payer is sent back to after a successful hosted payment. Must be an
# https:// URL (Chapa rejects http). Points to the agent payment-result page;
# the page reconciles the payment and activates the subscription immediately.
# When unset, no return redirect happens (payments then activate via webhook or
# the next /subscriptions/current call).
# CHAPA_RETURN_URL=https://your-domain.com/agent/subscription/result
